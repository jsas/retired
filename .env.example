# Dev markup overlay: draw on the running app and have a real model edit the
# source. Fill in the endpoint+model (and a key if your endpoint needs one) and
# restart `npm run dev`. With ENDPOINT unset, the overlay stays off entirely.
#
# Any OpenAI-compatible chat-completions server works: Ollama (/v1), LM Studio,
# OpenRouter, or a hosted API. The key is read only in the dev server (node) —
# it never reaches the browser bundle.

# Required to enable the overlay:
MARKUP_MODEL_ENDPOINT=http://localhost:1234/v1/chat/completions
MARKUP_MODEL=qwen2.5-vl-7b-instruct

# Optional bearer token for the endpoint (LM Studio: leave empty):
MARKUP_MODEL_API_KEY=

# Optional tuning:
# Attach the captured markup image (vision models only):
#MARKUP_MODEL_VISION=1
# Apply source edits to disk immediately (default on). Set 0 to hold them:
#MARKUP_AUTO_APPLY=1
# Send a serialized DOM snapshot as context (default on):
#MARKUP_DOM_SNAPSHOT=1
# Activation chord (default ctrl+shift+m). Modifiers: ctrl, shift, alt, meta:
#MARKUP_HOTKEY=ctrl+shift+m
# Override the engine's system prompt:
#MARKUP_SYSTEM_PROMPT=
