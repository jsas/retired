// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`tool catalog surface > advertises the same per-tool inputSchema the MCP server registers 1`] = `
[
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "section": {
          "default": "full",
          "description": "Which slice of the plan to return. Use summary/accounts/benefits/spending/spouse to save tokens; full returns everything.",
          "enum": [
            "full",
            "summary",
            "accounts",
            "benefits",
            "spending",
            "spouse",
          ],
          "type": "string",
        },
      },
      "required": [
        "section",
      ],
      "type": "object",
    },
    "name": "get_scenario",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "additionalProperties": {},
          "description": "Optional flat patch of top-level RetirementInputs fields to apply to a COPY of the plan before running (what-if). Validated against the scenario schema; invalid entries are reported, not applied.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
      },
      "type": "object",
    },
    "name": "run_projection",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "additionalProperties": {},
          "description": "Flat patch of top-level RetirementInputs fields defining ONE variant to compare against the current plan. Use variants for several.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "variants": {
          "description": "Up to 4 variants compared in ONE call (e.g. three retirement ages). Current plan is always included as the baseline. Takes precedence over the singular overrides.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "description": "Short name shown for this variant (e.g. "Retire at 60").",
                "type": "string",
              },
              "overrides": {
                "additionalProperties": {},
                "description": "Flat patch of top-level RetirementInputs fields defining this variant.",
                "propertyNames": {
                  "type": "string",
                },
                "type": "object",
              },
            },
            "required": [
              "overrides",
            ],
            "type": "object",
          },
          "maxItems": 4,
          "type": "array",
        },
      },
      "type": "object",
    },
    "name": "compare_scenarios",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Optional filters; call with {} for the full exploration.",
      "properties": {
        "categories": {
          "description": "Scope the explorer to specific lever families (e.g. ["cpp","oas"] for benefit timing only, ["pension_timing"] for employer-pension start ages). Omit for all.",
          "items": {
            "enum": [
              "cpp",
              "oas",
              "pension_timing",
              "withdrawal_order",
              "reverse_mortgage",
              "work",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "maxVariants": {
          "description": "Cap the number of variants returned (best first).",
          "maximum": 50,
          "minimum": 1,
          "type": "integer",
        },
      },
      "type": "object",
    },
    "name": "run_strategies",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "additionalProperties": {},
          "description": "Optional flat patch of top-level scalar fields to apply to a COPY of the plan before solving (what-if: solve under different assumptions).",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "runs": {
          "default": 500,
          "description": "Market futures to simulate per candidate. More = smoother, slower.",
          "maximum": 2000,
          "minimum": 50,
          "type": "integer",
        },
        "targetSuccessRate": {
          "default": 0.9,
          "description": "Target Monte Carlo success rate as a fraction, e.g. 0.9 = 90% chance the money lasts to max age.",
          "maximum": 0.99,
          "minimum": 0.5,
          "type": "number",
        },
      },
      "required": [
        "targetSuccessRate",
        "runs",
      ],
      "type": "object",
    },
    "name": "solve_spending",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "additionalProperties": {},
          "description": "Optional flat patch of top-level scalar fields to apply to a COPY of the plan before simulating (what-if: success rate under different assumptions).",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "runs": {
          "default": 500,
          "maximum": 2000,
          "minimum": 50,
          "type": "integer",
        },
        "volatility": {
          "description": "Annual return standard deviation. Defaults to the plan's returnVolatility.",
          "maximum": 0.5,
          "minimum": 0,
          "type": "number",
        },
      },
      "required": [
        "runs",
      ],
      "type": "object",
    },
    "name": "run_monte_carlo",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "fromAge": {
          "description": "First age to include (default: currentAge).",
          "type": "number",
        },
        "overrides": {
          "additionalProperties": {},
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "stride": {
          "description": "Return every Nth year (e.g. 5 covers a whole horizon in one call). The LAST year in range is always included.",
          "maximum": 20,
          "minimum": 1,
          "type": "integer",
        },
        "toAge": {
          "description": "Last age to include (default: maxAge). Keep ranges small to save tokens.",
          "type": "number",
        },
      },
      "type": "object",
    },
    "name": "get_schedule",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": {},
      "properties": {
        "changes": {
          "additionalProperties": {},
          "description": "Plan numbers the user just gave: currentAge, retirementAge, desiredSpending, rrspBalance, tfsaBalance, taxableBalance, cashCushionBalance, contributions, provinceCode, cpp/oas, etc. Scalars only. Prefer this wrapper; bare top-level fields also work. Call this immediately — do not recap the numbers in prose.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "rationale": {
          "description": "One sentence on the card (e.g. "Start the plan with the numbers you gave").",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "propose_plan",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "changes": {
          "additionalProperties": {},
          "description": "Person fields for a NEW partner plan (currentAge, retirementAge, balances, contributions, cpp/oas, desiredSpending). Ignored when scenarioId is set. Use {"enabled":false} or enabled:false to unlink.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "enabled": {
          "description": "false unlinks the partner (this plan becomes single). true with changes mints a new partner plan and links it.",
          "type": "boolean",
        },
        "name": {
          "description": "Name for a newly created partner plan (default "Partner").",
          "type": "string",
        },
        "rationale": {
          "type": "string",
        },
        "scenarioId": {
          "description": "Id of an existing saved plan to link as the partner. Preferred when the partner already has a plan.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "propose_spouse",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "bands": {
          "description": "Spending phases: pctOfBase (fraction of desiredSpending, e.g. 1, 0.85, 0.7) applying fromAge until the next band. Replaces the whole set.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "fromAge": {
                "type": "number",
              },
              "pctOfBase": {
                "type": "number",
              },
            },
            "required": [
              "fromAge",
              "pctOfBase",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "rationale": {
          "type": "string",
        },
      },
      "required": [
        "bands",
      ],
      "type": "object",
    },
    "name": "propose_spending_bands",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "periods": {
          "description": "Market-hypothesis anchors, any order. The engine sorts by age and interpolates linearly between them; outside the outermost anchors the flat investmentReturn/returnVolatility hold. The projection follows the return curve; volatility shapes Monte Carlo only. Empty array clears the hypothesis (back to flat constants). Replaces the whole set.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "age": {
                "description": "The age this anchor applies at.",
                "type": "number",
              },
              "return": {
                "description": "Expected annual return (decimal, e.g. -0.30 for a 30% crash, 0.07 for 7% growth). May be negative.",
                "type": "number",
              },
              "volatility": {
                "description": "Annual return standard deviation at this age (decimal, e.g. 0.25). Omit to keep the plan's flat volatility.",
                "minimum": 0,
                "type": "number",
              },
            },
            "required": [
              "age",
              "return",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "rationale": {
          "type": "string",
        },
      },
      "required": [
        "periods",
      ],
      "type": "object",
    },
    "name": "propose_market_periods",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": {},
      "properties": {
        "action": {
          "enum": [
            "add",
            "update",
            "remove",
          ],
          "type": "string",
        },
        "changes": {
          "additionalProperties": {},
          "description": "For update: the income-source fields to change. For add: also accepted — fields here merge under any top-level ones.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "rationale": {
          "type": "string",
        },
        "target": {
          "description": "For update/remove: the income source id, or its label if unique (e.g. "Work DB").",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "manage_income",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": {},
      "properties": {
        "action": {
          "enum": [
            "add",
            "update",
            "remove",
          ],
          "type": "string",
        },
        "changes": {
          "additionalProperties": {},
          "description": "For update: the cash-event fields to change. For add: also accepted — fields here merge under any top-level ones.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "rationale": {
          "type": "string",
        },
        "target": {
          "description": "For update/remove: the cash event id, or its label if unique (e.g. "Downsize").",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "manage_cash_event",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": {},
      "properties": {
        "action": {
          "enum": [
            "add",
            "update",
            "remove",
          ],
          "type": "string",
        },
        "changes": {
          "additionalProperties": {},
          "description": "For update: the debt fields to change. For add: also accepted — fields here merge under any top-level ones.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "rationale": {
          "type": "string",
        },
        "target": {
          "description": "For update/remove: the debt id, or its label if unique (e.g. "Mortgage").",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "manage_debt",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": {},
      "properties": {
        "action": {
          "enum": [
            "add",
            "update",
            "remove",
          ],
          "type": "string",
        },
        "amount": {
          "description": "For add, mode "fixed": dollars per year (today's dollars).",
          "type": "number",
        },
        "basis": {
          "description": "For add, mode "pct" only: which income the % rides on.",
          "enum": [
            "gross",
            "net",
          ],
          "type": "string",
        },
        "changes": {
          "additionalProperties": {},
          "description": "For update: the giving-stream fields to change. For add: also accepted — fields here merge under any top-level ones.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "fromAge": {
          "description": "For add: first giving age (inclusive).",
          "type": "number",
        },
        "label": {
          "description": "For add: the stream name, e.g. "Food Bank".",
          "type": "string",
        },
        "mode": {
          "description": "For add: "fixed" = amount $/yr (default); "pct" = pct of income.",
          "enum": [
            "pct",
            "fixed",
          ],
          "type": "string",
        },
        "pct": {
          "description": "For add, mode "pct": percentage points of income (10 = 10%).",
          "type": "number",
        },
        "rationale": {
          "type": "string",
        },
        "target": {
          "description": "For update/remove: the giving stream id, or its label if unique (e.g. "Parish").",
          "minLength": 1,
          "type": "string",
        },
        "toAge": {
          "anyOf": [
            {
              "type": "number",
            },
            {
              "type": "null",
            },
          ],
          "description": "For add: last giving age; null/omit = for life.",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "manage_giving",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "changes": {
          "additionalProperties": {},
          "description": "Fields to set. {"enabled":true,...} to turn it on, {"enabled":false} to turn it off. Reverse mortgage needs homeValue, appreciationRate, interestRate (and optionally draws or top-up). RDSP needs balance, contribution, familyIncome, dtcEligible. FHSA needs balance and contribution.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "kind": {
          "description": "Which special account: rm (reverse mortgage), rdsp, or fhsa.",
          "enum": [
            "rm",
            "reverse_mortgage",
            "rdsp",
            "fhsa",
          ],
          "type": "string",
        },
        "rationale": {
          "type": "string",
        },
      },
      "required": [
        "kind",
        "changes",
      ],
      "type": "object",
    },
    "name": "propose_account",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "description": "Which checkpoint to revert to: its label, or omit for the most recent one. Labels come from the change cards the user approved ("Add pension").",
          "type": "string",
        },
        "rationale": {
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "propose_revert",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "importance": {
          "default": 0.5,
          "description": "0..1: how important this fact is. Reserve 0.9+ for decisions and constraints ("user refuses to touch RRSP"), 0.3 for color.",
          "maximum": 1,
          "minimum": 0,
          "type": "number",
        },
        "keywords": {
          "description": "Category words a future question might use that are NOT in the text itself — the hypernyms of what the fact is about (text "likes oranges" → ["fruit", "food", "preference"]; "wants to retire to Nova Scotia" → ["location", "province", "move"]). The fact's own words are indexed automatically; only add what a later query would say differently.",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 12,
          "type": "array",
        },
        "rationale": {
          "type": "string",
        },
        "scope": {
          "default": "scenario",
          "description": "scenario = about this plan (shown in chats on this scenario). global = about the USER, travels across plans (e.g. "wants to retire to Nova Scotia").",
          "enum": [
            "scenario",
            "global",
          ],
          "type": "string",
        },
        "text": {
          "description": "The fact to remember, one or two self-contained sentences (e.g. "Spouse's DB pension pays $1,200/mo from 65" — never "it pays that").",
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "text",
        "scope",
        "importance",
      ],
      "type": "object",
    },
    "name": "remember",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 6,
          "maximum": 20,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "description": "Search words — single keywords work best (they match by word, not phrase; "fruit" finds "likes oranges" if it was saved with that keyword). Omit for the top-ranked memories outright.",
          "type": "string",
        },
      },
      "required": [
        "limit",
      ],
      "type": "object",
    },
    "name": "recall",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "list",
          "description": "list = enumerate saved plans. open = switch to one (give scenarioId or name). save_as = snapshot the current plan under a new name and open the copy.",
          "enum": [
            "list",
            "open",
            "save_as",
          ],
          "type": "string",
        },
        "name": {
          "description": "For open: the scenario NAME (case-insensitive, must be unique). For save_as: the name of the new copy.",
          "maxLength": 80,
          "minLength": 1,
          "type": "string",
        },
        "scenarioId": {
          "description": "For open: id of the saved scenario (from the ids given in your context).",
          "minLength": 1,
          "type": "string",
        },
        "withDetails": {
          "default": false,
          "description": "For list: true = include the key numbers of each plan (ages, balances, spending, benefits) so you can compare saved plans without opening them. Omit/false for a compact list.",
          "type": "boolean",
        },
      },
      "required": [
        "action",
        "withDetails",
      ],
      "type": "object",
    },
    "name": "list_scenarios",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "query": {
          "description": "Words to match (e.g. "tfsa room", "monte carlo", "tax table"). Omit or pass empty to return the full site map.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "find_page",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "Confirm-card label, e.g. "Open the Monte Carlo page".",
          "minLength": 1,
          "type": "string",
        },
        "rationale": {
          "type": "string",
        },
        "view": {
          "description": "View id, from find_page (e.g. "projection", "optimizer", "monte-carlo"). Do not confuse route names with view ids; the resolver normalizes for you.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "view",
        "label",
      ],
      "type": "object",
    },
    "name": "propose_navigate",
  },
]
`;

exports[`tool catalog surface > exposes every catalog tool to LLM providers (names, descriptions, JSON Schema) 1`] = `
[
  {
    "description": "Read the current retirement scenario (plan inputs: ages, balances, contributions, benefits, spending, charitable giving, withdrawal order, spouse, income sources, reverse mortgage).",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "section": {
          "default": "full",
          "description": "Which slice of the plan to return. Use summary/accounts/benefits/spending/spouse to save tokens; full returns everything.",
          "enum": [
            "full",
            "summary",
            "accounts",
            "benefits",
            "spending",
            "spouse",
          ],
          "type": "string",
        },
      },
      "required": [
        "section",
      ],
      "type": "object",
    },
    "name": "get_scenario",
  },
  {
    "description": "Run the engine on the current plan (optionally with overrides) and return the verdict: funded/depleted, key ages, tax, and a compact year digest.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "additionalProperties": {},
          "description": "Optional flat patch of top-level RetirementInputs fields to apply to a COPY of the plan before running (what-if). Validated against the scenario schema; invalid entries are reported, not applied.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
      },
      "type": "object",
    },
    "name": "run_projection",
  },
  {
    "description": "Compare the current plan against one or more variants (up to 4) defined by flat override patches, and return all outcomes plus deltas vs current. Use for "retire at 60 vs 65 vs 70?".",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "additionalProperties": {},
          "description": "Flat patch of top-level RetirementInputs fields defining ONE variant to compare against the current plan. Use variants for several.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "variants": {
          "description": "Up to 4 variants compared in ONE call (e.g. three retirement ages). Current plan is always included as the baseline. Takes precedence over the singular overrides.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "label": {
                "description": "Short name shown for this variant (e.g. "Retire at 60").",
                "type": "string",
              },
              "overrides": {
                "additionalProperties": {},
                "description": "Flat patch of top-level RetirementInputs fields defining this variant.",
                "propertyNames": {
                  "type": "string",
                },
                "type": "object",
              },
            },
            "required": [
              "overrides",
            ],
            "type": "object",
          },
          "maxItems": 4,
          "type": "array",
        },
      },
      "type": "object",
    },
    "name": "compare_scenarios",
  },
  {
    "description": "Run the deterministic strategy explorer: rank named lever variants (CPP/OAS timing, employer-pension start ages, withdrawal order, reverse mortgage, part-time work) against the current plan by sustainable spending, tax, and GIS. Optionally scope with categories/maxVariants. Use for "what levers help most?" steering.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "description": "Optional filters; call with {} for the full exploration.",
      "properties": {
        "categories": {
          "description": "Scope the explorer to specific lever families (e.g. ["cpp","oas"] for benefit timing only, ["pension_timing"] for employer-pension start ages). Omit for all.",
          "items": {
            "enum": [
              "cpp",
              "oas",
              "pension_timing",
              "withdrawal_order",
              "reverse_mortgage",
              "work",
            ],
            "type": "string",
          },
          "type": "array",
        },
        "maxVariants": {
          "description": "Cap the number of variants returned (best first).",
          "maximum": 50,
          "minimum": 1,
          "type": "integer",
        },
      },
      "type": "object",
    },
    "name": "run_strategies",
  },
  {
    "description": "Invert the verdict: find the most the user can spend per year (after tax) for a target Monte Carlo success rate. Accepts overrides for what-if solving. Use for "how much can I safely spend?"",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "additionalProperties": {},
          "description": "Optional flat patch of top-level scalar fields to apply to a COPY of the plan before solving (what-if: solve under different assumptions).",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "runs": {
          "default": 500,
          "description": "Market futures to simulate per candidate. More = smoother, slower.",
          "maximum": 2000,
          "minimum": 50,
          "type": "integer",
        },
        "targetSuccessRate": {
          "default": 0.9,
          "description": "Target Monte Carlo success rate as a fraction, e.g. 0.9 = 90% chance the money lasts to max age.",
          "maximum": 0.99,
          "minimum": 0.5,
          "type": "number",
        },
      },
      "required": [
        "targetSuccessRate",
        "runs",
      ],
      "type": "object",
    },
    "name": "solve_spending",
  },
  {
    "description": "Run the Monte Carlo simulation on the current plan (optionally with overrides) and return the success rate, median final balance, and depletion spread across market futures.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "additionalProperties": {},
          "description": "Optional flat patch of top-level scalar fields to apply to a COPY of the plan before simulating (what-if: success rate under different assumptions).",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "runs": {
          "default": 500,
          "maximum": 2000,
          "minimum": 50,
          "type": "integer",
        },
        "volatility": {
          "description": "Annual return standard deviation. Defaults to the plan's returnVolatility.",
          "maximum": 0.5,
          "minimum": 0,
          "type": "number",
        },
      },
      "required": [
        "runs",
      ],
      "type": "object",
    },
    "name": "run_monte_carlo",
  },
  {
    "description": "Return the year-by-year projection table (balances, withdrawals, tax, CPP/OAS/GIS, pension, employment, reverse mortgage) for an age range. Use stride to cover a whole horizon in one call.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "fromAge": {
          "description": "First age to include (default: currentAge).",
          "type": "number",
        },
        "overrides": {
          "additionalProperties": {},
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "stride": {
          "description": "Return every Nth year (e.g. 5 covers a whole horizon in one call). The LAST year in range is always included.",
          "maximum": 20,
          "minimum": 1,
          "type": "integer",
        },
        "toAge": {
          "description": "Last age to include (default: maxAge). Keep ranges small to save tokens.",
          "type": "number",
        },
      },
      "type": "object",
    },
    "name": "get_schedule",
  },
  {
    "description": "PROPOSE a batch of plan numbers as ONE confirm card. Args: { "changes": { currentAge, retirementAge, desiredSpending, rrspBalance, ... } }. Bare top-level fields also work. Call this as soon as the user gives ages, spending, balances, province, CPP/OAS, or contributions — even on a brand-new plan. Do NOT recap the numbers in prose first; the card IS the recap. Scalars only. Spouse, income, debts, events, and special accounts use their own tools.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": {},
      "properties": {
        "changes": {
          "additionalProperties": {},
          "description": "Plan numbers the user just gave: currentAge, retirementAge, desiredSpending, rrspBalance, tfsaBalance, taxableBalance, cashCushionBalance, contributions, provinceCode, cpp/oas, etc. Scalars only. Prefer this wrapper; bare top-level fields also work. Call this immediately — do not recap the numbers in prose.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "rationale": {
          "description": "One sentence on the card (e.g. "Start the plan with the numbers you gave").",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "propose_plan",
  },
  {
    "description": "PROPOSE linking a partner (another saved plan), creating a new partner plan then linking it, or unlinking. Partner numbers live on that plan, not inline. User confirms.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "changes": {
          "additionalProperties": {},
          "description": "Person fields for a NEW partner plan (currentAge, retirementAge, balances, contributions, cpp/oas, desiredSpending). Ignored when scenarioId is set. Use {"enabled":false} or enabled:false to unlink.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "enabled": {
          "description": "false unlinks the partner (this plan becomes single). true with changes mints a new partner plan and links it.",
          "type": "boolean",
        },
        "name": {
          "description": "Name for a newly created partner plan (default "Partner").",
          "type": "string",
        },
        "rationale": {
          "type": "string",
        },
        "scenarioId": {
          "description": "Id of an existing saved plan to link as the partner. Preferred when the partner already has a plan.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "propose_spouse",
  },
  {
    "description": "PROPOSE replacing the spending phases (go-go/slow-go/no-go as % of base spending by age; dollar amounts are desiredSpending × pctOfBase). User confirms.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "bands": {
          "description": "Spending phases: pctOfBase (fraction of desiredSpending, e.g. 1, 0.85, 0.7) applying fromAge until the next band. Replaces the whole set.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "fromAge": {
                "type": "number",
              },
              "pctOfBase": {
                "type": "number",
              },
            },
            "required": [
              "fromAge",
              "pctOfBase",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "rationale": {
          "type": "string",
        },
      },
      "required": [
        "bands",
      ],
      "type": "object",
    },
    "name": "propose_spending_bands",
  },
  {
    "description": "PROPOSE setting a market hypothesis: per-age expected-return (and optional volatility) anchors the engine interpolates between, so you can model a crash, boom, or choppy stretch instead of one constant return. The projection follows the return curve; volatility shapes Monte Carlo only. Pass an empty array to clear the hypothesis (back to flat constants). User confirms.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "periods": {
          "description": "Market-hypothesis anchors, any order. The engine sorts by age and interpolates linearly between them; outside the outermost anchors the flat investmentReturn/returnVolatility hold. The projection follows the return curve; volatility shapes Monte Carlo only. Empty array clears the hypothesis (back to flat constants). Replaces the whole set.",
          "items": {
            "additionalProperties": false,
            "properties": {
              "age": {
                "description": "The age this anchor applies at.",
                "type": "number",
              },
              "return": {
                "description": "Expected annual return (decimal, e.g. -0.30 for a 30% crash, 0.07 for 7% growth). May be negative.",
                "type": "number",
              },
              "volatility": {
                "description": "Annual return standard deviation at this age (decimal, e.g. 0.25). Omit to keep the plan's flat volatility.",
                "minimum": 0,
                "type": "number",
              },
            },
            "required": [
              "age",
              "return",
            ],
            "type": "object",
          },
          "type": "array",
        },
        "rationale": {
          "type": "string",
        },
      },
      "required": [
        "periods",
      ],
      "type": "object",
    },
    "name": "propose_market_periods",
  },
  {
    "description": "PROPOSE adding, updating, or removing an income source (pension, employment, self-employment, or rental). action "add" takes the source fields (endAge a number or explicit null). action "update"/"remove" take target (id or unique label). User confirms.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": {},
      "properties": {
        "action": {
          "enum": [
            "add",
            "update",
            "remove",
          ],
          "type": "string",
        },
        "changes": {
          "additionalProperties": {},
          "description": "For update: the income-source fields to change. For add: also accepted — fields here merge under any top-level ones.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "rationale": {
          "type": "string",
        },
        "target": {
          "description": "For update/remove: the income source id, or its label if unique (e.g. "Work DB").",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "manage_income",
  },
  {
    "description": "PROPOSE adding, updating, or removing a cash event (inflow to an account, or outflow adding to spending). action "add" takes the event fields. action "update"/"remove" take target (id or unique label). User confirms.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": {},
      "properties": {
        "action": {
          "enum": [
            "add",
            "update",
            "remove",
          ],
          "type": "string",
        },
        "changes": {
          "additionalProperties": {},
          "description": "For update: the cash-event fields to change. For add: also accepted — fields here merge under any top-level ones.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "rationale": {
          "type": "string",
        },
        "target": {
          "description": "For update/remove: the cash event id, or its label if unique (e.g. "Downsize").",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "manage_cash_event",
  },
  {
    "description": "PROPOSE adding, updating, or removing a debt (mortgage or consumer: credit card, loan, line of credit). The balance compounds at its interest rate; the monthly payment is funded from spending until paid off. action "add" takes the debt fields. action "update"/"remove" take target (id or unique label). User confirms.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": {},
      "properties": {
        "action": {
          "enum": [
            "add",
            "update",
            "remove",
          ],
          "type": "string",
        },
        "changes": {
          "additionalProperties": {},
          "description": "For update: the debt fields to change. For add: also accepted — fields here merge under any top-level ones.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "rationale": {
          "type": "string",
        },
        "target": {
          "description": "For update/remove: the debt id, or its label if unique (e.g. "Mortgage").",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "manage_debt",
  },
  {
    "description": "PROPOSE adding, updating, or removing a charitable giving stream (household-level; all receipts pool into ONE donation tax credit). mode "fixed" (the default): amount dollars/yr (NOT indexed for inflation) — a fixed add is just {label, mode:"fixed", amount, fromAge}; pct/basis are pct-mode-only and auto-filled. mode "pct": pct of income in percentage points (10 = 10%), basis "gross" (pre-tax income stack) or "net" (after-tax). fromAge/toAge window (toAge null or omitted = for life). The credit follows CRA rules: 14% on the first $200, 29%/33% above, per-province rates, 75%-of-income claim cap, non-refundable. action "add" takes the stream fields (top level, or inside changes). action "update"/"remove" take target (id or unique label). User confirms.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": {},
      "properties": {
        "action": {
          "enum": [
            "add",
            "update",
            "remove",
          ],
          "type": "string",
        },
        "amount": {
          "description": "For add, mode "fixed": dollars per year (today's dollars).",
          "type": "number",
        },
        "basis": {
          "description": "For add, mode "pct" only: which income the % rides on.",
          "enum": [
            "gross",
            "net",
          ],
          "type": "string",
        },
        "changes": {
          "additionalProperties": {},
          "description": "For update: the giving-stream fields to change. For add: also accepted — fields here merge under any top-level ones.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "fromAge": {
          "description": "For add: first giving age (inclusive).",
          "type": "number",
        },
        "label": {
          "description": "For add: the stream name, e.g. "Food Bank".",
          "type": "string",
        },
        "mode": {
          "description": "For add: "fixed" = amount $/yr (default); "pct" = pct of income.",
          "enum": [
            "pct",
            "fixed",
          ],
          "type": "string",
        },
        "pct": {
          "description": "For add, mode "pct": percentage points of income (10 = 10%).",
          "type": "number",
        },
        "rationale": {
          "type": "string",
        },
        "target": {
          "description": "For update/remove: the giving stream id, or its label if unique (e.g. "Parish").",
          "minLength": 1,
          "type": "string",
        },
        "toAge": {
          "anyOf": [
            {
              "type": "number",
            },
            {
              "type": "null",
            },
          ],
          "description": "For add: last giving age; null/omit = for life.",
        },
      },
      "required": [
        "action",
      ],
      "type": "object",
    },
    "name": "manage_giving",
  },
  {
    "description": "PROPOSE enabling/configuring (or disabling) a special account: kind "rm" (reverse mortgage), "rdsp", or "fhsa". Pass changes with the fields to set; {"enabled":false} turns it off. User confirms.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "changes": {
          "additionalProperties": {},
          "description": "Fields to set. {"enabled":true,...} to turn it on, {"enabled":false} to turn it off. Reverse mortgage needs homeValue, appreciationRate, interestRate (and optionally draws or top-up). RDSP needs balance, contribution, familyIncome, dtcEligible. FHSA needs balance and contribution.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
        "kind": {
          "description": "Which special account: rm (reverse mortgage), rdsp, or fhsa.",
          "enum": [
            "rm",
            "reverse_mortgage",
            "rdsp",
            "fhsa",
          ],
          "type": "string",
        },
        "rationale": {
          "type": "string",
        },
      },
      "required": [
        "kind",
        "changes",
      ],
      "type": "object",
    },
    "name": "propose_account",
  },
  {
    "description": "PROPOSE rolling the plan back to a checkpoint — an automatic snapshot taken just before a previously-approved change landed. Use when an experiment did not pan out ("that made it worse, undo it"). User confirms.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "checkpoint": {
          "description": "Which checkpoint to revert to: its label, or omit for the most recent one. Labels come from the change cards the user approved ("Add pension").",
          "type": "string",
        },
        "rationale": {
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "propose_revert",
  },
  {
    "description": "Save a durable fact to memory for later conversations — about THIS plan (scope "scenario": a decision the user made, a figure they quoted, a constraint like "cannot touch the RRSP") or about the user themselves (scope "global": preferences, life plans). ONLY when clearly important; never for numbers already in the plan or in computed results. When the fact uses a specific term a future question might generalize (oranges → fruit), pass those category words as keywords so the fact can be found again.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "importance": {
          "default": 0.5,
          "description": "0..1: how important this fact is. Reserve 0.9+ for decisions and constraints ("user refuses to touch RRSP"), 0.3 for color.",
          "maximum": 1,
          "minimum": 0,
          "type": "number",
        },
        "keywords": {
          "description": "Category words a future question might use that are NOT in the text itself — the hypernyms of what the fact is about (text "likes oranges" → ["fruit", "food", "preference"]; "wants to retire to Nova Scotia" → ["location", "province", "move"]). The fact's own words are indexed automatically; only add what a later query would say differently.",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 12,
          "type": "array",
        },
        "rationale": {
          "type": "string",
        },
        "scope": {
          "default": "scenario",
          "description": "scenario = about this plan (shown in chats on this scenario). global = about the USER, travels across plans (e.g. "wants to retire to Nova Scotia").",
          "enum": [
            "scenario",
            "global",
          ],
          "type": "string",
        },
        "text": {
          "description": "The fact to remember, one or two self-contained sentences (e.g. "Spouse's DB pension pays $1,200/mo from 65" — never "it pays that").",
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "text",
        "scope",
        "importance",
      ],
      "type": "object",
    },
    "name": "remember",
  },
  {
    "description": "Search what you remember (facts saved in earlier conversations). Matching is by KEYWORD — query with the words a category would be filed under ("fruit", "pension", "city"), not a full sentence. If nothing matches, the closest memories are returned anyway; use them before telling the user you don't know. Omit the query to list the most important current memories — do this at the START of a conversation to ground yourself.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 6,
          "maximum": 20,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "description": "Search words — single keywords work best (they match by word, not phrase; "fruit" finds "likes oranges" if it was saved with that keyword). Omit for the top-ranked memories outright.",
          "type": "string",
        },
      },
      "required": [
        "limit",
      ],
      "type": "object",
    },
    "name": "recall",
  },
  {
    "description": "Saved scenarios. action "list" (default) enumerates names/ids and which is active; withDetails adds each plan's key numbers. action "open" switches to another saved plan (scenarioId or name). action "save_as" snapshots the current plan under a new name and opens the copy.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "action": {
          "default": "list",
          "description": "list = enumerate saved plans. open = switch to one (give scenarioId or name). save_as = snapshot the current plan under a new name and open the copy.",
          "enum": [
            "list",
            "open",
            "save_as",
          ],
          "type": "string",
        },
        "name": {
          "description": "For open: the scenario NAME (case-insensitive, must be unique). For save_as: the name of the new copy.",
          "maxLength": 80,
          "minLength": 1,
          "type": "string",
        },
        "scenarioId": {
          "description": "For open: id of the saved scenario (from the ids given in your context).",
          "minLength": 1,
          "type": "string",
        },
        "withDetails": {
          "default": false,
          "description": "For list: true = include the key numbers of each plan (ages, balances, spending, benefits) so you can compare saved plans without opening them. Omit/false for a compact list.",
          "type": "boolean",
        },
      },
      "required": [
        "action",
        "withDetails",
      ],
      "type": "object",
    },
    "name": "list_scenarios",
  },
  {
    "description": "Search the site's page map by any words a user would type ("tfsa room", "monte carlo", "tax table"). Returns the ranked matches, each with route/hash one can share, plus the current page flagged as "you are already here". Omit query (or pass empty) for the full site map. Use whenever the user asks WHERE something lives or what pages exist.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "query": {
          "description": "Words to match (e.g. "tfsa room", "monte carlo", "tax table"). Omit or pass empty to return the full site map.",
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "find_page",
  },
  {
    "description": "PROPOSE switching the app to a named view (UI-level navigation — not a plan mutation). Resolves page words to their view — "steering" → dashboard, "monte carlo" → montecarlo, "solver" → solver — name it from find_page. Shows a confirm card with the destination; on approval the app opens it. When unbound (no UI in this host) returns the #/hash so the model can share the link instead.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "Confirm-card label, e.g. "Open the Monte Carlo page".",
          "minLength": 1,
          "type": "string",
        },
        "rationale": {
          "type": "string",
        },
        "view": {
          "description": "View id, from find_page (e.g. "projection", "optimizer", "monte-carlo"). Do not confuse route names with view ids; the resolver normalizes for you.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "view",
        "label",
      ],
      "type": "object",
    },
    "name": "propose_navigate",
  },
]
`;
