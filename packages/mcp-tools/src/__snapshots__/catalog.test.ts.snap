          "type": "string",
        },
        "monthlyPayment": {
          "type": "number",
        },
        "rationale": {
          "type": "string",
        },
        "startAge": {
          "type": "number",
        },
      },
      "required": [
        "label",
        "kind",
        "balance",
        "interestRate",
        "monthlyPayment",
      ],
      "type": "object",
    },
