    },
    "name": "get_scenario",
  },
  {
    "inputSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "overrides": {
          "additionalProperties": {},
          "description": "Optional flat patch of top-level RetirementInputs fields to apply to a COPY of the plan before running (what-if). Validated against the scenario schema; invalid entries are reported, not applied.",
          "propertyNames": {
            "type": "string",
          },
          "type": "object",
        },
      },
      "type": "object",
    },
    "name": "run_projection",
  },
  {
    "inputSchema": {
