  {
    "description": "Save a durable fact to memory for later conversations — about THIS plan (scope "scenario": a decision the user made, a figure they quoted, a constraint like "cannot touch the RRSP") or about the user themselves (scope "global": preferences, life plans). ONLY when clearly important; never for numbers already in the plan or in computed results. When the fact uses a specific term a future question might generalize (oranges → fruit), pass those category words as keywords so the fact can be found again.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "importance": {
          "default": 0.5,
          "description": "0..1: how important this fact is. Reserve 0.9+ for decisions and constraints ("user refuses to touch RRSP"), 0.3 for color.",
          "maximum": 1,
          "minimum": 0,
          "type": "number",
        },
        "keywords": {
          "description": "Category words a future question might use that are NOT in the text itself — the hypernyms of what the fact is about (text "likes oranges" → ["fruit", "food", "preference"]; "wants to retire to Nova Scotia" → ["location", "province", "move"]). The fact's own words are indexed automatically; only add what a later query would say differently.",
          "items": {
            "minLength": 1,
            "type": "string",
          },
          "maxItems": 12,
          "type": "array",
        },
        "rationale": {
          "type": "string",
        },
        "scope": {
          "default": "scenario",
          "description": "scenario = about this plan (shown in chats on this scenario). global = about the USER, travels across plans (e.g. "wants to retire to Nova Scotia").",
          "enum": [
            "scenario",
            "global",
          ],
          "type": "string",
        },
        "text": {
          "description": "The fact to remember, one or two self-contained sentences (e.g. "Spouse's DB pension pays $1,200/mo from 65" — never "it pays that").",
          "maxLength": 500,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "text",
        "scope",
        "importance",
      ],
      "type": "object",
    },
    "name": "remember",
  },
  {
    "description": "Search what you remember (facts saved in earlier conversations). Matching is by KEYWORD — query with the words a category would be filed under ("fruit", "pension", "city"), not a full sentence. If nothing matches, the closest memories are returned anyway; use them before telling the user you don't know. Omit the query to list the most important current memories — do this at the START of a conversation to ground yourself.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "limit": {
          "default": 6,
          "maximum": 20,
          "minimum": 1,
          "type": "integer",
        },
        "query": {
          "description": "Search words — single keywords work best (they match by word, not phrase; "fruit" finds "likes oranges" if it was saved with that keyword). Omit for the top-ranked memories outright.",
          "type": "string",
        },
      },
      "required": [
        "limit",
      ],
      "type": "object",
    },
    "name": "recall",
  },
  {
    "description": "Switch to another SAVED scenario (by id or name). Use when the user wants to look at / work on a different plan. Unsaved edits in the current plan are saved first, so nothing is lost.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Alternatively, the scenario NAME — matched case-insensitively; must be unambiguous.",
          "minLength": 1,
          "type": "string",
        },
        "scenarioId": {
          "description": "Id of the saved scenario to open (from the ids given in your context).",
          "minLength": 1,
          "type": "string",
        },
      },
      "type": "object",
    },
    "name": "open_scenario",
  },
  {
    "description": "Snapshot the CURRENT plan as a new saved scenario with a name, and make it active. Use when the user wants to keep a variant alongside the original (e.g. "keep this as its own plan") — the original stays untouched.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Name for the new scenario (e.g. "Downsized at 65"). Duplicates are allowed.",
          "maxLength": 80,
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "name",
      ],
      "type": "object",
    },
    "name": "save_scenario_as",
  },
  {
    "description": "List every SAVED scenario: names, ids, and which one is active. With withDetails, also return each plan's key numbers (ages, balances, spending, CPP/OAS) so you can compare saved plans without switching. Use whenever the user asks what plans exist or which to open.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "withDetails": {
          "default": false,
          "description": "true = include the key numbers of each plan (ages, balances, spending, benefits) so you can compare saved plans without opening them. Omit/false for a compact list.",
          "type": "boolean",
        },
      },
      "required": [
        "withDetails",
      ],
      "type": "object",
    },
    "name": "list_scenarios",
  },
  {
    "description": "Search the site's page map by any words a user would type ("tfsa room", "monte carlo", "tax table"). Returns the ranked matches, each with route/hash one can share, plus the current page flagged as "you are already here". Use whenever the user asks WHERE something lives.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "query": {
          "description": "Words to match (e.g. "tfsa room", "monte carlo", "tax table"). Match is deterministic; the catalog has the right keywords in it — re-case freely.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "query",
      ],
      "type": "object",
    },
    "name": "find_page",
  },
  {
    "description": "The full site map: every page (view), its route (#/hash), and one-line purpose. Use for "what can this app do?", "what pages exist?", or before guessing where something lives.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {},
      "type": "object",
    },
    "name": "get_sitemap",
  },
  {
    "description": "PROPOSE switching the app to a named view (UI-level navigation — not a plan mutation). Resolves page words to their view — "steering" → eq, "monte carlo" → montecarlo, "solver" → solver — name it from find_page or get_sitemap. Shows a confirm card with the destination; on approval the app opens it. When unbound (no UI in this host) returns the #/hash so the model can share the link instead.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "additionalProperties": false,
      "properties": {
        "label": {
          "description": "Confirm-card label, e.g. "Open the Monte Carlo page".",
          "minLength": 1,
          "type": "string",
        },
        "rationale": {
          "type": "string",
        },
        "view": {
          "description": "View id, from find_page or get_sitemap (e.g. "projection", "steering", "monte-carlo"). Do not confuse route names with view ids; the resolver normalizes for you.",
          "minLength": 1,
          "type": "string",
        },
      },
      "required": [
        "view",
        "label",
      ],
      "type": "object",
    },
    "name": "propose_navigate",
  },
]
`;
