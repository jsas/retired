  },
  {
    "description": "PROPOSE adding a spouse/partner (or editing spouse fields, or removing). The spouse is a second plan combined for household totals. User confirms.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
