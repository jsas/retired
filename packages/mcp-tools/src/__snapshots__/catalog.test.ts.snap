      "type": "object",
    },
    "name": "set_scenario_value",
  },
  {
    "description": "PROPOSE changing several top-level scalar fields at once (e.g. CPP+OAS timing). One confirm card. For structural blocks use the dedicated propose_* tools.",
    "jsonSchema": {
      "$schema": "https://json-schema.org/draft/2020-12/schema",
