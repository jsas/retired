{
  "name": "retirement-app",
  "private": true,
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode singlefile",
    "build:all": "npm run build && npm run build:single",
    "lint": "oxlint",
    "test": "vitest run",
    "test:watch": "vitest",
    "probe": "vite --config probe/vite.config.ts",
    "probe:test": "vitest run --config vitest.probe.config.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "@assistant-ui/react": "^0.15.17",
    "@mlc-ai/web-llm": "^0.2.84",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dompurify": "^3.4.14",
    "marked": "^18.0.11",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sql.js": "^1.14.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@retired/ai-bridge": "*",
    "@retired/markup-assistant": "*",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.33.0",
    "oxlint": "^1.75.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^4.1.11"
  }
}
